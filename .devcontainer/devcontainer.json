{
  "name": "crt-cashflow-engine",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "pip install uv && uv venv .venv && uv pip install --python .venv/bin/python -e '.[dev,gui]' && .venv/bin/python -m pytest -q -m fast",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "CRT Cashflow Engine GUI",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  }
}
