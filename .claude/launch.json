{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gui",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "src/crt/gui/app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true"
      ],
      "port": 8501
    },
    {
      "name": "web",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "web/dist"
      ],
      "port": 8765
    }
  ]
}
